        print(f"Submitting job with: sbatch {script_name}")
        try:
            out = subprocess.check_output(["sbatch", script_name], stderr=subprocess.STDOUT)
            print(out.decode())
        except Exception as e:
            print(f"Error submitting job: {e}")
    else:
        print(f"You can submit the job manually with: sbatch {script_name}")

if __name__ == "__main__":
