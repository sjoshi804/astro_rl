def prompt_int(prompt, minval, maxval):
    while True:
        try:
            val = int(input(prompt))
            if minval <= val <= maxval:
                return val
            print(f"Please enter a number between {minval} and {maxval}.")
        except ValueError:
            print("Please enter a valid integer.")

def prompt_choice(prompt, choices):
    for i, (key, desc) in enumerate(choices, 1):
        print(f"  {i}) {key:20} - {desc}")
    while True:
        val = input(prompt).strip()
        if val.isdigit() and 1 <= int(val) <= len(choices):
            return choices[int(val)-1][0]
        for key, _ in choices:
            if val == key:
                return key
        print("Please enter a valid number or config name.")

def prompt_str(prompt, default=None, validator=None):
    while True:
        val = input(prompt + (f" [{default}]" if default else "") + ": ").strip()
        if not val and default is not None:
            return default
        if validator is None or validator(val):
            return val
        print("Invalid input.")

